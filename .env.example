# URL pública do site (usada em canonical, Open Graph e sitemap)
NEXT_PUBLIC_SITE_URL=https://www.frutiferasorganicas.com.br

# Canal do YouTube oficial
NEXT_PUBLIC_YOUTUBE_URL=https://www.youtube.com/@Frut%C3%ADferasOrg%C3%A2nicas

# Contato
NEXT_PUBLIC_EMAIL=contato@frutiferasorganicas.com.br

# Google AdSense (aceita ca-pub-XXXX ou pub-XXXX; deixe vazio enquanto nao aprovado)
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT=

# Ezoic (defina NEXT_PUBLIC_EZOIC=1 para ativar; tem prioridade sobre o AdSense)
NEXT_PUBLIC_EZOIC=

# Google Analytics (GA4)
NEXT_PUBLIC_GA_ID=

# Google Search Console (verificacao por meta tag).
# Cole apenas o conteudo do meta tag (ex.: "abc123...").
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Checkout do produto (Hotmart/Kiwify). Enquanto vazio, /curso mostra a lista de espera.
NEXT_PUBLIC_CHECKOUT_URL=

# Newsletter: endpoint que recebe POST JSON {email, origem}.
# Padrao: /newsletter.php (script no proprio dominio, integrado ao Brevo).
# A chave da API fica em public/_brevo-key.php (nao versionado).
# Se quiser usar outro servico (Mailchimp/Formspree), informe a URL completa.
NEXT_PUBLIC_NEWSLETTER_ENDPOINT=
