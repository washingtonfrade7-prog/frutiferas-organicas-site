DTSTAMP:20260923T120000Z
DTSTART;VALUE=DATE:20261014
DTEND;VALUE=DATE:20261015
SUMMARY:Adubar com bokashi (1ª vez)
DESCRIPTION:1 a 2 colheres de sopa na borda do vaso\, longe do caule. Cubra com
 substrato e regue. Repita a cada 30 a 45 dias.
BEGIN:VALARM
TRIGGER:-PT15H
ACTION:DISPLAY
DESCRIPTION:Adubar com bokashi (1ª vez)
END:VALARM
END:VEVENT
